# Database (use a MongoDB Atlas cluster, or a local replica set)
MONGODB_URI=

# Authentication (generate with: npx auth secret  or  openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Admin panel login at /admin (separate from customer accounts).
# Generate the hash with:  npm run admin-hash -- "YourPassword"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH_B64=

# Image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (start with TEST keys)
RAZORPAY_KEY_ID=rzp_test_TmAIOtmAn2Tr0A
RAZORPAY_KEY_SECRET=dptuEOnK7r0Kpci9JQkhQ38S
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="SAPNAKRITI <orders@yourdomain.com>"

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Name + language of your APPROVED order-confirmation template
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANG=en
# "true" if your template has a DOCUMENT header (invoice PDF is attached)
WHATSAPP_INVOICE_AS_DOCUMENT=false

# Protects /api/cron/maintenance (any long random string)
